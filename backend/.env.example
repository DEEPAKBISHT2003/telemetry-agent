# =====================================================================
# AI Telemetry Backend Configuration Example (.env)
# =====================================================================
# Copy this file to .env and configure for your local or production environment.
# Never commit real passwords, secrets, or connection strings.
# =====================================================================

# Application Environment: development, testing, staging, production
APP_ENV=development

# Application Debug Mode (strictly false in production)
DEBUG=false

# Log Verbosity: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Base API Route Prefix
API_V1_PREFIX=/api/v1

# Asynchronous PostgreSQL Database Connection URL
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<dbname>
# Leave blank or commented out if running health checks without database.
DATABASE_URL=postgresql+asyncpg://telemetry_user:replace_with_secure_password@localhost:5432/telemetry_db

# Database Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30.0
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true

# Cross-Origin Resource Sharing (CORS)
# Restrictive by default. Provide a comma-separated list of allowed origins.
# Example: https://dashboard.telemetry.corp.internal,https://admin.telemetry.corp.internal
CORS_ORIGINS=

# Maximum Allowed Request Payload Size in Bytes (Default: 2097152 = 2MB)
MAX_REQUEST_BODY_BYTES=2097152
