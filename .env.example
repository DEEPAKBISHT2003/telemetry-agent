# Developer Identity Configuration (Optional override - defaults to interactive enrollment)
# MEMBER_ID=mem-401e19f040
# DEVICE_ID=dev-401e19f040bb

# Collector Configuration
COLLECTOR_VERSION=0.1.2
LOG_LEVEL=INFO
HEARTBEAT_INTERVAL_SECONDS=30
# TELEMETRY_DATA_DIR=~/.telemetry_agent/data

# Event Source Toggles & Intervals
GIT_MONITOR_INTERVAL_SECONDS=10
GIT_MONITOR_PATHS=.
ANTIGRAVITY_MONITOR_ENABLED=true

# PyPI / TestPyPI Publishing Credentials (Local only - used by scripts/publish_pypi.py)
TWINE_USERNAME=__token__
TWINE_PASSWORD=

# Jira API Integration (Optional read-only issue resolution)
# JIRA_BASE_URL=https://your-domain.atlassian.net
# JIRA_USERNAME=your-account-email@example.com
# JIRA_API_TOKEN=your-atlassian-api-token
# JIRA_AUTH_TYPE=basic
# JIRA_KEY_PATTERN=
